{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chat-mother-forker": {
        "type": "local",
        "command": [
          "uvx",
          "--refresh",
          "chat-mother-forker"
        ]
      },
      "pyddock": {
        "type": "local",
        "command": [
          "uvx",
          "--refresh",
          "pyddock",
          "serve"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ]
      }
    }
  }
}