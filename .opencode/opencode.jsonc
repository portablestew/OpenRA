{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chat-mother-forker": {
        "type": "local",
        "command": [
          "uvx",
          "--refresh",
          "chat-mother-forker"
        ]
      },
      "pyddock": {
        "type": "local",
        "command": [
          "uvx",
          "--refresh",
          "pyddock",
          "serve"
        ]
      },
      "text-adventure": {
        "type": "local",
        "command": [
          "uvx",
          "--refresh",
          "text-adventure-mcp"
        ]
      }
    }
  }
}